
# Basic offline Tanglish transliteration.
# This is rule-based, not an AI translation model.

COMMON = {
    "vanakkam": "வணக்கம்",
    "nandri": "நன்றி",
    "amma": "அம்மா",
    "appa": "அப்பா",
    "tamizh": "தமிழ்",
    "tamil": "தமிழ்",
    "epdi": "எப்படி",
    "enna": "என்ன",
    "nalla": "நல்ல",
    "irukken": "இருக்கேன்",
    "saptiya": "சாப்பிட்டியா",
    "ungal": "உங்கள்",
    "nan": "நான்",
    "nee": "நீ",
    "neenga": "நீங்கள்",
    "ungalukku": "உங்களுக்கு",
}

VOWELS = {
    "aa": "ஆ", "ii": "ஈ", "ee": "ஈ", "uu": "ஊ",
    "oo": "ஊ", "ai": "ஐ", "au": "ஔ",
    "a": "அ", "i": "இ", "u": "உ", "e": "எ", "o": "ஒ"
}

SIGNS = {
    "aa": "ா", "ii": "ீ", "ee": "ீ", "uu": "ூ",
    "oo": "ூ", "ai": "ை", "au": "ௌ",
    "a": "", "i": "ி", "u": "ு", "e": "ெ", "o": "ொ"
}

CONSONANTS = {
    "ng": "ங", "ny": "ஞ", "sh": "ஷ", "zh": "ழ",
    "th": "த", "dh": "த", "ch": "ச", "nj": "ஞ",
    "k": "க", "g": "க", "s": "ஸ", "j": "ஜ",
    "t": "ட", "d": "ட", "n": "ன", "N": "ண",
    "p": "ப", "b": "ப", "m": "ம", "y": "ய",
    "r": "ர", "l": "ல", "v": "வ", "w": "வ",
    "h": "ஹ", "f": "ஃப"
}

PULLI = "்"

def to_tamil(text: str) -> str:
    words = re.findall(r"[A-Za-z]+|[^A-Za-z]+", text)
    output = []

    for word in words:
        if not word.isalpha():
            output.append(word)
            continue

        lower = word.lower()
        if lower in COMMON:
            output.append(COMMON[lower])
            continue

        result = []
        i = 0

        while i < len(lower):
            vowel = next(
                (v for v in sorted(VOWELS, key=len, reverse=True)
                 if lower.startswith(v, i)), None
            )
            if vowel:
                result.append(VOWELS[vowel])
                i += len(vowel)
                continue

            consonant = next(
                (c for c in sorted(CONSONANTS, key=len, reverse=True)
                 if lower.startswith(c.lower(), i)), None
            )
            if not consonant:
                result.append(lower[i])
                i += 1
                continue

            base = CONSONANTS[consonant]
            i += len(consonant)

            next_consonant = next(
                (c for c in sorted(CONSONANTS, key=len, reverse=True)
                 if lower.startswith(c.lower(), i)), None
            )

            if next_consonant and next_consonant.lower() == consonant.lower():
                result.append(base + PULLI)
                continue

            next_vowel = next(
                (v for v in sorted(VOWELS, key=len, reverse=True)
                 if lower.startswith(v, i)), None
            )

            if next_vowel:
                result.append(base + SIGNS[next_vowel])
                i += len(next_vowel)
            elif i >= len(lower):
                result.append(base + PULLI)
            else:
                result.append(base)

        output.append("".join(result))

    return "".join(output)


REVERSE = {
    "அ": "a", "ஆ": "aa", "இ": "i", "ஈ": "ee",
    "உ": "u", "ஊ": "oo", "எ": "e", "ஏ": "ே",
    "ஐ": "ai", "ஒ": "o", "ஓ": "oo", "ஔ": "au",
    "க": "ka", "ங": "nga", "ச": "cha", "ஞ": "nya",
    "ட": "ta", "ண": "na", "த": "tha", "ந": "na",
    "ப": "pa", "ம": "ma", "ய": "ya", "ர": "ra",
    "ல": "la", "வ": "va", "ழ": "zha", "ள": "la",
    "ற": "ra", "ன": "na", "ஜ": "ja", "ஷ": "sha",
    "ஸ": "sa", "ஹ": "ha",
}

SIGNS_REVERSE = {
    "ா": "aa", "ி": "i", "ீ": "ee", "ு": "u",
    "ூ": "oo", "ெ": "e", "ே": "ae", "ை": "ai",
    "ொ": "o", "ோ": "oo", "ௌ": "au",
}

def to_roman(text: str) -> str:
    result = []
    i = 0
    while i < len(text):
        char = text[i]
        if char in REVERSE:
            roman = REVERSE[char]
            i += 1
            if i < len(text) and text[i] == PULLI:
                result.append(roman[:-1] if roman.endswith("a") else roman)
                i += 1
            elif i < len(text) and text[i] in SIGNS_REVERSE:
                result.append(roman[:-1] + SIGNS_REVERSE[text[i]])
                i += 1
            else:
                result.append(roman)
        else:
            result.append(char)
            i += 1
    return "".join(result)
